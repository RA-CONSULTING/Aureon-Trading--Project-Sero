# Public deployment identifiers only. No API keys, cookies, or operator secrets.
# Leave AUREON_PUBLIC_ORIGIN empty until Cloud Run status.url is read back.
AUREON_PUBLIC_ORIGIN=
AUREON_PUBLIC_ACCESS_MODE=hybrid
AUREON_OWNER_ORIGIN=
AUREON_IAP_AUDIENCE=/projects/4435775023/locations/europe-west1/services/aureon-fusion-web
AUREON_IAP_ADMIN_EMAIL_SHA256=LOWERCASE_DOMAIN_SEPARATED_SHA256
AUREON_ENTRY_SERVICE_ACCOUNT_EMAIL=aureon-web-entry@aureon-trading.iam.gserviceaccount.com
AUREON_ENTRY_SERVICE_ACCOUNT_ID=SERVICE_ACCOUNT_NUMERIC_ID
AUREON_BRIDGE_URL=https://10.40.0.2:8443
AUREON_REVISION=FULL_VERIFIED_GIT_SHA
AUREON_OPERATOR_INTENT_KEY_FILE=/etc/aureon-public/bridge-key.pem

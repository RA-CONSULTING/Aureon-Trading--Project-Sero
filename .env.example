# Aureon Fusion staging defaults. Copy to .env (gitignored) and fill outside git.
# Live trading stays off unless both arm flags are set by the operator.

AUREON_LIVE_TRADING=0
AUREON_FUSION_ARM_LIVE=
CONFIRM_LIVE_TRADING=
BINANCE_TESTNET=true
PAPER_MODE=true

# Required before the fusion HTTP service will listen. At least 16 characters.
# Do not commit a real value.
AUREON_FUSION_API_TOKEN=
AUREON_FUSION_BIND=127.0.0.1
AUREON_FUSION_PORT=8765
AUREON_FUSION_RATE_LIMIT=60
AUREON_FUSION_RATE_WINDOW_S=60
AUREON_FUSION_CACHE_TTL_S=5
AUREON_LOG_PATH=
AUREON_ERROR_LOG_PATH=
# Leave empty. Set only if you have an error-tracking endpoint. Nothing is sent otherwise.
AUREON_ERROR_WEBHOOK_URL=

# Self-repair runs unless this is 1, true, yes, or on.
AUREON_SELF_REPAIR_KILL=

BINANCE_API_KEY=
BINANCE_API_SECRET=
GEMINI_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

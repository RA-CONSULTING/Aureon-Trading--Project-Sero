# Recovery material and live credentials stay outside Git history.
.env
.env.*
.env1
.env*.txt
!*.env.example
!*.env.template
*.dpapi
*.recovery-key
portable-recovery-key.txt
provider_keys.key
provider_keys.json.enc
__pycache__/
*.pyc
.venv/
node_modules/
thoughts.jsonl
aureon-os-upstream/supabase/.temp/
/supabase/.temp/

# The complete original workspace, including these local-only files,
# is retained in the authenticated encrypted full-workspace-backup archive.
full-workspace-backup/workspace.aes.part*
# Generated cloud commissioning evidence must be written outside the repository.
deployment/google-cloud/**/*receipt*.json
deployment/google-cloud/**/*readback*.json
deployment/google-cloud/**/*progress*.json
deployment/google-cloud/**/*plan*.json

# Paper-mode fleet output. The organs rewrite these; they are not source.
/logs/
*.log
.aureon_runtime/
/pids/
/hnc_daemon_logs/
/unified_logs/
/aureon_fusion/state/*.sqlite
/aureon_fusion/state/*.sqlite-*
/aureon_fusion/state/flight_record.jsonl
/aureon_fusion/state/flight_health.json
/aureon_fusion/state/api_cache/
/aureon_fusion/state/grand_wheel/

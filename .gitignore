# Recovery material and live credentials stay outside Git history.
.env
.env.*
.env1
.env*.txt
!*.env.example
!*.env.template
*.dpapi
*.recovery-key
portable-recovery-key.txt
provider_keys.key
provider_keys.json.enc
__pycache__/
*.pyc
.venv/
node_modules/

# The complete original workspace, including these local-only files,
# is retained in the authenticated encrypted full-workspace-backup archive.
full-workspace-backup/workspace.aes.part*
